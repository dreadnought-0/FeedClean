    <!-- Info dialogs (ⓘ) -->
    <string name="info_ok">Got it</string>
    <string name="info_skip_shop">Shop posts are videos with a product link that aren\'t marked as an ad or promotion. Needs Shop-post detection.</string>
    <string name="info_skip_paid">Posts TikTok marks as “Ad” or “Sponsored”. Needs paid-ad detection.</string>
    <string name="info_skip_promoted">Posts marked as promotional content or a paid partnership. Needs promoted-post detection.</string>
    <string name="info_skip_live">LIVE streams that are selling products. A plain LIVE preview is never skipped. Needs LIVE-shopping detection.</string>
    <string name="info_ni_button">Sends TikTok\'s own “Not interested” for the post on screen when you tap it on the bubble card. Only runs on your tap, and needs the bubble.</string>
    <string name="info_auto_ni">Before skipping a Shop post that isn\'t an ad, FeedClean taps TikTok\'s “Not interested” for you. TikTok sees these taps. It follows the pace limit; past it, FeedClean only skips.</string>
    <string name="info_block_button">Blocks the creator of the post on screen, after you tap Block on the bubble card. FeedClean never blocks on its own. Needs the bubble.</string>
    <string name="info_bubble">The bubble is the only way to open the card with Skip, Not interested and Block. Hide it and those buttons are unavailable.</string>
    <string name="info_cover">Covers the post on screen while auto-skip scrolls past it. It doesn\'t change what gets skipped.</string>
    <string name="info_detection">Reads the labels TikTok shows on screen (Ad, Sponsored, Paid partnership, product links, LIVE shopping). Nothing leaves your phone.</string>
    <string name="info_shop_detect">A post counts as a Shop post when it shows a product link.</string>
    <string name="info_session">Counts every video you scroll past, not only detections, so Stats can show ad and Shop percentages.</string>
    <string name="info_log">Records what FeedClean decided for each post (type, decision, why). View or export it on the Debug screen.</string>

    <!-- Guide: What Armed means -->
    <string name="guide_title">What “Armed” means</string>
    <string name="guide_intro">A badge shows whether an option will really act the next time a matching post shows up — not just whether its switch is on.</string>
    <string name="guide_armed">Switch is on and everything it needs is ready.</string>
    <string name="guide_off">Switch is off. Nothing happens.</string>
    <string name="guide_blocked">Switch is on, but something it needs is missing. The badge says what and links to the fix.</string>
    <string name="guide_paused">Switch is on, but paused — by “Pause everything” or the safety stop after too many skips in a row.</string>
    <string name="guide_skip_title">Skip options need all of these</string>
    <string name="guide_skip_1">Accessibility access is on</string>
    <string name="guide_skip_2">Detection is on, for that kind of post</string>
    <string name="guide_skip_3">Auto-skip is on</string>
    <string name="guide_skip_4">At least one place under “Where it skips”</string>
    <string name="guide_skip_5">Not paused</string>
    <string name="guide_live_title">Checked live — the badge won\'t change</string>
    <string name="guide_live_body">TikTok is in front · your screen is on (if you chose that) · FeedClean isn\'t in the middle of another action · the pace limit isn\'t reached. The line under the count tells you when it\'s waiting.</string>
    <string name="guide_taps_title">Your own taps are different</string>
    <string name="guide_taps_body">The Block button and the Not interested button only run when you tap them. They need accessibility access and the bubble. “Pause everything” doesn\'t turn them off, but switching it on stops one that\'s already running.</string>
    <string name="guide_auto_ni_title">Auto Not interested needs more</string>
    <string name="guide_auto_ni_1">Everything a Shop skip needs</string>
    <string name="guide_auto_ni_2">“Skip Shop posts” on — it only acts on skipped Shop posts</string>
    <string name="guide_auto_ni_3">You accepted the risk note</string>
    <string name="guide_auto_ni_note">If the pace limit is reached, FeedClean skips without tapping.</string>

