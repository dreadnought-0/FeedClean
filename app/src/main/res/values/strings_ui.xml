    <!-- Automated Not interested: account-risk dialog -->
    <string name="ui_risk_dialog_title">Automate Not interested?</string>
    <string name="ui_risk_dialog_body_seen">TikTok sees every Not interested tap. Repeated automated feedback is the most visible thing FeedClean can do, and TikTok\'s terms restrict automated interaction, so this carries some risk to your account.</string>
    <string name="ui_risk_dialog_body_rate_limit">These taps share the rate limit with blocks: at least %1$d s apart and at most %2$d per hour. When the limit is reached, FeedClean skips without tapping.</string>
    <string name="ui_risk_dialog_body_off">You can turn this off at any time here, or pause everything with the kill-switch.</string>
    <string name="ui_risk_dialog_accept">Turn on</string>
    <string name="ui_risk_dialog_decline">Keep off</string>

